{
  "name": "max-strength-app",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/setup-firebase-config.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:backend": "node scripts/setup-firebase-config.cjs && esbuild server/worker.ts server/cron-daily-reminders.ts server/cron-weekly-coach-report.ts server/cron-leaderboards.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist --out-extension:.js=.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "start:worker": "node dist/worker.cjs",
    "cron:reminders": "node dist/cron-daily-reminders.cjs",
    "cron:coach-report": "node dist/cron-weekly-coach-report.cjs",
    "cron:leaderboards": "node dist/cron-leaderboards.cjs",
    "test:rules": "firebase emulators:exec 'vitest run tests/firestore.rules.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@google-cloud/pubsub": "^5.3.0",
    "@google/genai": "^1.29.0",
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-ical": "^0.26.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.0.0",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.24.0",
    "shadcn": "^4.2.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fetch-blob": "^4.0.0"
  }
}
